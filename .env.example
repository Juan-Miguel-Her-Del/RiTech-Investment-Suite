# Copiar a .env y asignar valores propios. Nunca subir .env a Git.
POSTGRES_USER=ritech
POSTGRES_DB=ritech
POSTGRES_PASSWORD=
JWT_SECRET=
# Para ejecutar Python fuera de Compose, ajustar usuario y contraseña en esta URL.
DATABASE_URL=postgresql+psycopg://ritech:CAMBIAR@localhost:5432/ritech
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
# Proveedores: demo, fmp, twelvedata. Para fmp usar MARKET_SYMBOL=^NDX.
MARKET_PROVIDER=demo
MARKET_API_KEY=
MARKET_SYMBOL=NDX
MARKET_TIMEOUT_SECONDS=8
MARKET_CACHE_SECONDS=60
